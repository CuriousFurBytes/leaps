# =============================================================================
# leaps — .gitignore
# Learning Environment for Any Progressive Subject
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/
# uv
.python-version
uv.lock

# ── Environment Variables ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
# Exception: keep example env files
!.env.example
!.env.template

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
nosetests.xml
test-results/
junit*.xml

# ── Type Checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.pyre/
.ruff_cache/

# ── Build / Docs (Zensical) ───────────────────────────────────────────────────
# `zensical build` output and cache.
site/
_site/
.cache/
.zensical/
docs/_build/
*.mo
*.pot

# ── OS ────────────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Windows
Thumbs.db
Thumbs.db:encdata
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ── Editors & IDEs ────────────────────────────────────────────────────────────
# VS Code — ignore workspace state but keep shared settings
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist
tags

# Emacs
*~
\#*\#
.#*

# ── Conda ─────────────────────────────────────────────────────────────────────
.conda/
conda-meta/

# ── Docker ────────────────────────────────────────────────────────────────────
# Keep Dockerfiles and compose files. Ignore local override files.
docker-compose.override.yml
docker-compose.local.yml

# ── Node (for Zensical themes, tooling) ──────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ── Large Data Files (use Git LFS instead) ───────────────────────────────────
# If these files are needed, add them to .gitattributes for LFS tracking
*.pkl
*.pickle
*.h5
*.hdf5
*.npz
*.npy
# Datasets — add specific small CSVs individually if they are needed
# Large CSVs should be in LFS or excluded entirely
# *.csv

# ── Model Weights ─────────────────────────────────────────────────────────────
*.pt
*.pth
*.bin
*.safetensors
*.gguf
*.ggml

# ── Credentials / Secrets ─────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.crt
credentials.json
service-account*.json
*secret*
*token*
# Exception: keep example/template credential files
!*secret.example*
!*token.example*

# ── Personal / Private Notes ──────────────────────────────────────────────────
# Add your private files here. These patterns are gitignored by convention
# so personal notes never accidentally get committed.
PRIVATE/
private/
*.private.md
personal/
_personal/

# ── Obsidian ──────────────────────────────────────────────────────────────────
# Obsidian workspace state (machine-specific, not shared)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
# Keep: plugins, snippets, themes (shared config)
# Ignore: per-machine state
.obsidian/plugins/*/data.json

# ── Temporary / Misc ──────────────────────────────────────────────────────────
*.tmp
*.temp
*.log
*.pid
*.seed
*.bak
*.orig
tmp/
temp/
scratch/
